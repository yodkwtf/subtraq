# Copy this file to .env.local and fill in your own values.
# All NEXT_PUBLIC_* values are exposed to the browser (this is expected for the
# Supabase anon key, which is safe to ship publicly when RLS is enabled).

# --- AI features (optional) ---
# Powers AI Insights, Ask AI, and the Add-form auto-fill. The app works without it.
# Server-side only (never exposed to the browser). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the model. Defaults to the rolling `gemini-flash-latest` alias, which
# tracks the current free-tier Flash model. Set a specific one if you prefer, e.g.
# GEMINI_MODEL=gemini-flash-lite-latest

# --- Accounts & cloud sync (optional) ---
# Without these, the app still runs fully in guest mode (data stays on-device).
# Find both in the Supabase dashboard: Project URL under Settings -> API, and the
# Publishable key (sb_publishable_...) under Settings -> API Keys. See guide.md 5.2.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# --- SEO / Open Graph (optional) ---
# Your deployed site URL, used to build absolute metadata/OG image URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
